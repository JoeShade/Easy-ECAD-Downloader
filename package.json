{
  "name": "easy-ecad-downloader",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "audit": "npm audit --audit-level=moderate",
    "lint": "eslint .",
    "pretest": "node tests/helpers/check_node_version.js",
    "test": "vitest run",
    "qa:preflight": "node tests/headless-qa/preflight.js",
    "qa:run": "node tests/headless-qa/run.js",
    "qa:auth": "node tests/headless-qa/auth.js",
    "qa:lint": "python -m ruff check --cache-dir .qa-output/cache/ruff tests/headless-qa",
    "qa:smoke": "vitest run tests/headless-qa && python -m unittest discover -s tests/headless-qa -p test_*.py",
    "validate": "npm run lint && npm test && npm run audit && git diff --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "eslint": "^10.3.0",
    "jsdom": "^29.0.1",
    "puppeteer": "25.13.0",
    "vitest": "^4.1.12"
  }
}
